# openagent.email configuration — copy to .env and fill in.
# Requires modern Docker Compose v2+ (`docker compose` or a compatible
# docker-compose that supports `config --format json`). Docker Compose
# v5.5.1 is also supported. Do not rely on unverified legacy v1 details.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# The domain your agent addresses live on (identities look like fox-k7d2@DOMAIN).
# You must control its DNS — run ./deploy/dns-records.sh after `up -d`.
DOMAIN=example.com

# Comma-separated ADMIN Bearer keys: full access, can manage identities and
# act as any address. Keep these offline — day-to-day agent calls should use
# the per-identity scoped token returned by POST /v1/identities instead.
# Generate one with:  openssl rand -hex 32
API_KEYS=change-me-generate-with-openssl-rand-hex-32

# Password for the single catch-all mailbox (MAIL_ACCOUNT@DOMAIN) that actually
# stores all mail. Agents never see this; only the api service uses it.
# Generate one with:  openssl rand -hex 24
MAIL_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# Stable private key for validating email-backed task threads. Keep it when
# rotating MAIL_PASSWORD, otherwise old task history can no longer be checked.
# Generate one with: openssl rand -hex 32
TASK_SIGNING_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Optional secondary domains (comma-separated, e.g. "sub.example.com,other.org").
# When set, identities may be created on DOMAIN or any domain in EXTRA_DOMAINS.
# Note: deploy scripts (Certbot SANs, DKIM provisioning) currently configure the
# primary DOMAIN; automated deploy-script multi-domain provisioning is pending.
# EXTRA_DOMAINS=

# Comma-separated domains that identities may use in From. Leave unset to allow
# sending from all configured domains (DOMAIN + EXTRA_DOMAINS); set to restrict.
# ALLOWED_SEND_DOMAINS=example.com

# Localpart of the catch-all account (default "agent" → agent@DOMAIN).
# MAIL_ACCOUNT=agent

# Where the REST API listens. The default binds localhost ONLY — reach it via
# SSH tunnel or a TLS reverse proxy (see docs/security.md). Do NOT set
# 0.0.0.0 unless you understand the exposure.
# API_BIND=127.0.0.1
# API_PORT=3100

# Built-in read-only human inbox at /ui (true by default). Set false to make
# every /ui route return 404.
# UI_ENABLED=true

# Task claim/lease endpoints and expiry recovery are opt-in. Default false = disabled.
# Single API process per mailbox required when enabled.
TASK_LEASES_ENABLED=false
# M3 reclaim decoupling (default false): claim derives expiry from server time; audit SMTP cannot block reclaim.
# Late-receipt tolerance is always on and is not gated by this flag.
# WARNING: with the journal enabled, expired-kind intent records accumulate OPEN with no production
# drain while the emitter is hard-disabled and can exhaust the 10000-record journal capacity.
# Do NOT enable in production before the separately approved emitter work lands (commander-2091).
TASK_LEASES_EXPIRY_AUDIT_M3=false
TASK_LEASES_OVERLAY_BOUND=false
# Public-read lease overlay bound (default false): list/detail stop replaying unindexed lease events after 15 minutes.
# M2 pending journal (default false): restart-safe generation fence + claim_lost; records/defers expiry-audit work. Requires TASK_LEASES_ENABLED.
# Production emitter stays hard-disabled. Genuine first provision only: docs/task-lease-journal.md
TASK_LEASES_PENDING_JOURNAL=false

# TLS certificate checks for the API's IMAP/SMTP connections. Defaults stay
# false because the bundled mailserver begins with a self-signed certificate.
# Set both true after switching it to a trusted certificate (for example,
# Let's Encrypt), or when connecting to an external public mail server.
# IMAP_TLS_REJECT_UNAUTHORIZED=false
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# Optional compliance archive mailbox. Default off: leave unset/blank. When
# set, every API/MCP/task outbound message adds this one envelope recipient;
# it is never written to To/Bcc MIME headers. Use an external mailbox only
# with an approved privacy/retention policy and as a trusted archive boundary:
# it receives the exact MIME, including internal-message stamps when present.
# ALWAYS_BCC must be an independent archive outside DOMAIN. Same-domain values
# are rejected: the shared catch-all makes them unsuitable as an independent
# compliance destination, and duplicate suppression is not that boundary.
# Every enabled archive requires an explicit 32+ character TASK_SIGNING_SECRET.
# The app enforces presence and length only, not entropy: generate a
# high-entropy value (this example uses `openssl rand -hex 32`). Bare-process
# SMTP_PASS fallback is allowed only with no archive. Compose already requires
# this secret.
# If at least one original RCPT is accepted and this configured archive RCPT is
# rejected, Nodemailer partial-success is preserved with a content-free warning,
# even if another original RCPT was rejected.
# If the archive is accepted while no original RCPT is reported accepted, the
# API fails even when SMTP omitted explicit rejected outcomes.
# Later relay/Postfix delivery failures after queue acceptance are visible only
# in relay logs or DSNs, not synchronously through the API.
# ALWAYS_BCC=archive@example.net

# ── SERVER-SIDE PUSH NOTIFICATIONS (ntfy) ───────────────────────────────────

# The ntfy container stays in the Compose stack even when false (about 20 MB
# RAM) so the service graph stays predictable; false disables the API
# notification routes and the IMAP watcher.
NTFY_ENABLED=true

# Public/base URL written into ntfy. Keep localhost or an internal URL for the
# server-only loop. Phone delivery needs a public HTTPS reverse proxy; set its
# exact origin here and restart the full stack before creating a phone reader.
NOTIFY_PUBLIC_URL=http://127.0.0.1:2586

# Let ntfy forward unknown topics to ntfy.sh by default. Set false for a fully
# isolated server (recommended when you do not use ntfy federation).
NTFY_UPSTREAM=true

# Admin password for ntfy only. It is never returned to agents or MCP clients.
# Generate one with: openssl rand -hex 24
NTFY_ADMIN_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# Human-alert notification cap per authorized identity per rolling hour
# (0 = unlimited). This is separate from SEND_RATE_LIMIT.
# NOTIFY_RATE_LIMIT=10

# Mail-arrival push policy: otp (default), all, or none. `otp` means a
# verification code or link; external mail never wakes an agent topic.
# PUSH_POLICY=otp

# Optional public origin of the human dashboard. When set, mail-arrival ntfy
# pushes include a click action that opens this URL (no deep link path).
# Must not include userinfo (https://user:pass@… is rejected) — credentials
# must never ride the notification channel.
# DASHBOARD_PUBLIC_URL=https://mail.example.com/ui

# Optional public origin advertised in MCP RFC 9728 Protected Resource Metadata
# (and used instead of trusting the request Host). Use https for any non-loopback
# deployment so Bearer tokens are never implied over plaintext HTTP.
# MCP_PUBLIC_URL=https://mail.example.com

# MCP tools/call per-token rate limits (sliding window per minute; 0 = off).
# OAuth keys by grantId, oa_ by address; admin is exempt. Read/write buckets
# are independent (write = tier minimal+). Defaults: 60 read / 20 write.
# MCP_RATE_READ_PER_MIN=60
# MCP_RATE_WRITE_PER_MIN=20

# 阻塞等待上限（秒）。mail_wait_for / POST /v1/messages/wait 的 timeoutSec 与
# task_* wait 服务端封顶均静默钳到此值（schema 仍广告 max 600，不 400）。
# 默认 60；可配上限 600。公网反代读超时场景建议保持 ≤60。
# MCP_MAX_WAIT_SECONDS=60

# 是否信任 X-Forwarded-For 首跳作为客户端 IP（预鉴权限流 / UI 登录桶 / 审计）。
# 默认 false。直连公网开 true = 任何人可伪造 XFF 绕过 IP 限量——等于自杀。
# true 的硬性前置：反代必须覆写/剥离客户端自供 XFF（见 docs/security.md）；
# append 式保留客户端左侧值则 IP 限量对轮换伪造失效。
# TRUST_PROXY_HEADERS=false

# 公网边缘姿态：true 时关闭 CIMD SSRF 私网放行（RFC1918/loopback/CGNAT/ULA 全拒）。
# 默认 false（tailnet/loopback 部署不受影响）。169.254 等永拒清单始终生效。
# OAE_PUBLIC_EDGE=false

# ── OUTBOUND WEBHOOKS ───────────────────────────────────────────────────────
# Fail-closed；默认 false，与 parseConfig / Compose 插值一致。true 时仍要求上方
# TASK_SIGNING_SECRET 已设置且 ≥32（Compose 已强制该密钥）。
WEBHOOKS_ENABLED=false

# 可选签名根。整行保持注释/省略，让变量在容器中缺席（undefined）。
# 不要写成空值：空串或不足 32 字符会拒绝启动。需要独立根时用 openssl rand -hex 32。
# 同名已导出的 shell 变量优先于 env-file；轮换密钥时请先 unset，避免旧导出覆盖本文件。
# WEBHOOK_SIGNING_SECRET=
# WEBHOOK_SIGNING_SECRET_PREVIOUS=

# 是否允许私网 webhook 目标（默认 false）。OAE_PUBLIC_EDGE=true 时运行时强制 false。
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# 允许的目标端口 CSV（默认 443）。
# WEBHOOK_ALLOWED_PORTS=443

# 配额与投递上限。下列项允许显式 0：MAX_SUBSCRIPTIONS、MAX_PER_ADDRESS、
# APPROVAL_ARGS_MAX_BYTES、ROTATION_OVERLAP_MS、RATE_CREATE/TEST/DELIVER_PER_MIN。
# 其余项有各自下限。默认与 parseConfig 一致。
# 上限提示：MAX_ATTEMPTS<=11；PAYLOAD_MAX_BYTES bounded by JSON_BODY_LIMIT_BYTES。
# WEBHOOK_MAX_SUBSCRIPTIONS=16
# WEBHOOK_MAX_PER_ADDRESS=4
# WEBHOOK_MAX_ATTEMPTS=11
# WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# WEBHOOK_MAX_CONCURRENT=8
# WEBHOOK_POOL_RETRY_MS=5000
# WEBHOOK_PAYLOAD_MAX_BYTES=16384
# WEBHOOK_APPROVAL_ARGS_MAX_BYTES=4096
# WEBHOOK_APPROVAL_ARGS_MAX_DEPTH=4
# WEBHOOK_RESPONSE_MAX_BYTES=4096
# WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300
# WEBHOOK_DISABLE_THRESHOLD=10
# WEBHOOK_ROTATION_OVERLAP_MS=86400000
# WEBHOOK_LOG_RETENTION_DAYS=30
# WEBHOOK_RATE_CREATE_PER_MIN=10
# WEBHOOK_RATE_TEST_PER_MIN=3
# WEBHOOK_RATE_DELIVER_PER_MIN=60

# 预鉴权 IP 限量（每分钟；0 = 关闭）。键 = clientIp()。
# /authorize + /oauth/token + /oauth/revoke 共用 OAUTH；/mcp 无/坏 token 用 MCP_PREAUTH。
# MCP_PREAUTH 默认 120（OAuth 引导握手探 401 是规范动作；共享出口下 60 偏紧）。
# OAUTH_RATE_PER_MIN=30
# MCP_PREAUTH_RATE_PER_MIN=120

# Identity store directory (default ./data in the API process). Designed for a
# single writer process (Compose runs one API); multi-process shared DATA_DIR
# is unsupported even though each save is atomic on disk.
# DATA_DIR=./data

# Per-identity send rate limit, messages per rolling hour (0 = unlimited).
# SEND_RATE_LIMIT=20

# Auto-delete messages older than this many days (0 = keep forever).
# RETENTION_DAYS=30
# RETENTION_CHECK_HOURS=6

# Small-VPS tuning (these are also the compose defaults):
# ENABLE_CLAMAV=0        # antivirus; needs ~1GB extra RAM if enabled
# ENABLE_FAIL2BAN=1
# ENABLE_SPAMASSASSIN=0

# Outbound relay (recommended for deliverability on VPS ranges with bad rep,
# or when port 25 outbound is blocked — check with ./deploy/doctor.sh).
# Example for Amazon SES:
#   DEFAULT_RELAY_HOST=email-smtp.us-east-1.amazonaws.com
#   RELAY_HOST=email-smtp.us-east-1.amazonaws.com
#   RELAY_PORT=587
#   RELAY_USER=<ses-smtp-username>
#   RELAY_PASSWORD=<ses-smtp-password>
# Leave blank to send directly from your VPS (requires clean IP + PTR + port 25).
DEFAULT_RELAY_HOST=
RELAY_HOST=
RELAY_PORT=587
RELAY_USER=
RELAY_PASSWORD=

# Automatic TLS via Let's Encrypt is opt-in. Before enabling it, DNS A/AAAA for
# mail.$DOMAIN must point to this host and inbound TCP 80 must be open. Use a
# contact address outside this mailserver if possible, then follow the exact
# bootstrap commands in README (the certbot profile must issue before DMS starts).
# SSL_TYPE=letsencrypt
# SSL_DOMAIN=mail.example.com   # must be mail.$DOMAIN
# LETSENCRYPT_EMAIL=admin@example.net  # optional; omit only if you accept no CA email
