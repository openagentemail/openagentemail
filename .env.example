# openagent.email configuration — copy to .env and fill in.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# The domain your agent addresses live on (identities look like fox-k7d2@DOMAIN).
# You must control its DNS — run ./deploy/dns-records.sh after `up -d`.
DOMAIN=example.com

# Comma-separated ADMIN Bearer keys: full access, can manage identities and
# act as any address. Keep these offline — day-to-day agent calls should use
# the per-identity scoped token returned by POST /v1/identities instead.
# Generate one with:  openssl rand -hex 32
API_KEYS=change-me-generate-with-openssl-rand-hex-32

# Password for the single catch-all mailbox (MAIL_ACCOUNT@DOMAIN) that actually
# stores all mail. Agents never see this; only the api service uses it.
# Generate one with:  openssl rand -hex 24
MAIL_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# Stable private key for validating email-backed task threads. Keep it when
# rotating MAIL_PASSWORD, otherwise old task history can no longer be checked.
# Generate one with: openssl rand -hex 32
TASK_SIGNING_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Localpart of the catch-all account (default "agent" → agent@DOMAIN).
# MAIL_ACCOUNT=agent

# Where the REST API listens. The default binds localhost ONLY — reach it via
# SSH tunnel or a TLS reverse proxy (see docs/security.md). Do NOT set
# 0.0.0.0 unless you understand the exposure.
# API_BIND=127.0.0.1
# API_PORT=3100

# Built-in read-only human inbox at /ui (true by default). Set false to make
# every /ui route return 404.
# UI_ENABLED=true

# TLS certificate checks for the API's IMAP/SMTP connections. Defaults stay
# false because the bundled mailserver begins with a self-signed certificate.
# Set both true after switching it to a trusted certificate (for example,
# Let's Encrypt), or when connecting to an external public mail server.
# IMAP_TLS_REJECT_UNAUTHORIZED=false
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# ── SERVER-SIDE PUSH NOTIFICATIONS (ntfy) ───────────────────────────────────

# v0.3 keeps the ntfy container in the Compose stack even when false (about
# 20 MB RAM) so the service graph stays predictable; false disables the API
# notification routes and the IMAP watcher. Phone setup is v0.3.1, not this
# release.
NTFY_ENABLED=true

# Public/base URL written into ntfy. It may remain localhost or an internal
# URL in v0.3; only add a public HTTPS reverse proxy when doing v0.3.1.
NOTIFY_PUBLIC_URL=http://127.0.0.1:2586

# Let ntfy forward unknown topics to ntfy.sh by default. Set false for a fully
# isolated server (recommended when you do not use ntfy federation).
NTFY_UPSTREAM=true

# Admin password for ntfy only. It is never returned to agents or MCP clients.
# Generate one with: openssl rand -hex 24
NTFY_ADMIN_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# Human-alert notification cap per authorized identity per rolling hour
# (0 = unlimited). This is separate from SEND_RATE_LIMIT.
# NOTIFY_RATE_LIMIT=10

# Mail-arrival push policy: otp (default), all, or none. `otp` means a
# verification code or link; external mail never wakes an agent topic.
# PUSH_POLICY=otp

# Per-identity send rate limit, messages per rolling hour (0 = unlimited).
# SEND_RATE_LIMIT=20

# Auto-delete messages older than this many days (0 = keep forever).
# RETENTION_DAYS=30
# RETENTION_CHECK_HOURS=6

# Small-VPS tuning (these are also the compose defaults):
# ENABLE_CLAMAV=0        # antivirus; needs ~1GB extra RAM if enabled
# ENABLE_FAIL2BAN=1
# ENABLE_SPAMASSASSIN=0

# Outbound relay (recommended for deliverability on VPS ranges with bad rep,
# or when port 25 outbound is blocked — check with ./deploy/doctor.sh).
# Example for Amazon SES:
#   DEFAULT_RELAY_HOST=email-smtp.us-east-1.amazonaws.com
#   RELAY_HOST=email-smtp.us-east-1.amazonaws.com
#   RELAY_PORT=587
#   RELAY_USER=<ses-smtp-username>
#   RELAY_PASSWORD=<ses-smtp-password>
# Leave blank to send directly from your VPS (requires clean IP + PTR + port 25).
DEFAULT_RELAY_HOST=
RELAY_HOST=
RELAY_PORT=587
RELAY_USER=
RELAY_PASSWORD=

# Automatic TLS via Let's Encrypt (recommended for real use): uncomment and
# also uncomment port 80 in compose.yaml, then `docker compose up -d`.
# SSL_TYPE=letsencrypt
# SSL_DOMAIN=mail.example.com   # must be mail.$DOMAIN
