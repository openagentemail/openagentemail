{
  "name": "@openagentemail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "openagent.email REST API — identities, inbox read, OTP extraction, wait-for-message, send.",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "bun build src/main.ts src/ntfy-provision.ts --target bun --outdir dist && bun run scripts/copy-ui-to-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:approval-publication": "node scripts/sync-approval-publication.mjs --check && node scripts/run-approval-python-verifier.mjs",
    "lint:ui": "eslint src/ui",
    "format:ui": "prettier --write 'src/ui/**/*.{js,css}'",
    "gold:ui": "bun run scripts/compare-ui-gold.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.6.14",
    "imapflow": "^1.0.186",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16",
    "sanitize-html": "2.17.6",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "2.16.1",
    "bun-types": "^1.2.21",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2"
  }
}
