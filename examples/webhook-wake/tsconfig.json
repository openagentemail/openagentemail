{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "typeRoots": ["../../packages/api/node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
