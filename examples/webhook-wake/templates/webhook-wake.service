[Unit]
Description=openagent.email webhook-wake receiver (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/opt/openagentemail/examples/webhook-wake
ExecStart=/usr/bin/bun src/main.ts --config /etc/webhook-wake/config.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
# read-only home keeps the colocated Orca install visible; true would hide it.
ProtectHome=read-only
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=/run/user/%U
# Optional operator file for extra runtime paths. Do not put secrets here.
EnvironmentFile=-/etc/webhook-wake/runtime.env
PrivateTmp=true
ReadWritePaths=/var/lib/webhook-wake
AmbientCapabilities=
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
