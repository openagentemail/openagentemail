[Unit]
Description=openagent.email webhook-wake receiver (per-user instance)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/openagentemail/examples/webhook-wake
# Config lives under the operator home (readable with ProtectHome=read-only).
# /usr/bin/bun is a placeholder. Substitute the absolute Bun this user
# instance can execute (`command -v bun`). This tree does not install or
# symlink Bun at /usr/bin.
ExecStart=/usr/bin/bun src/main.ts --config %h/.config/webhook-wake/config.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# User instance: systemd.unit(5) expands %h/%U for the calling user, not root.
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=/run/user/%U
# Writable durable store: ~/.local/state/webhook-wake (set dedup.path to match).
StateDirectory=webhook-wake
ReadWritePaths=%h/.local/state/webhook-wake
PrivateTmp=true

[Install]
WantedBy=default.target
