# openagent.email API-only configuration for an external mail server.
# Requires modern Docker Compose v2+ (`docker compose` or a compatible
# docker-compose that supports `config --format json`). Docker Compose
# v5.5.1 is also supported. Do not rely on unverified legacy v1 details.
#
# Your mail provider needs one catch-all mailbox: a mailbox that receives mail
# sent to any prefix at DOMAIN (for example, fox-k7d2@example.com). Put that
# mailbox account's IMAP/SMTP credentials below. Agents never receive them.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# The domain your agent addresses use (fox-k7d2@DOMAIN). Your mail provider
# must accept all prefixes at this domain in the catch-all mailbox below.
DOMAIN=example.com

# Comma-separated admin Bearer keys. Generate one with:
#   openssl rand -hex 32
API_KEYS=change-me-generate-with-openssl-rand-hex-32

# IMAP settings for the catch-all mailbox. Ask your mail provider for these.
IMAP_HOST=imap.example-mail-provider.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=catch-all@example.com
IMAP_PASS=change-me-imap-password

# SMTP settings for the same catch-all mailbox. The provider must allow this
# account to send as your agent addresses; see the external mail server guide.
SMTP_HOST=smtp.example-mail-provider.com
SMTP_PORT=587
SMTP_USER=catch-all@example.com
SMTP_PASS=change-me-smtp-password

# Stable private key for validating email-backed task threads. Keep it when
# rotating SMTP_PASS, otherwise old task history can no longer be checked.
# Generate one with: openssl rand -hex 32
TASK_SIGNING_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Optional secondary domains (comma-separated, e.g. "sub.example.com,other.org").
# When set, identities may be created on DOMAIN or any domain in EXTRA_DOMAINS.
# Your external mail provider must route catch-all mail for these domains to the
# IMAP account configured above.
# EXTRA_DOMAINS=

# Use true for an external server with a valid public CA certificate. The
# default false preserves compatibility with the bundled self-signed server.
IMAP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Optional compliance archive mailbox. Default off: leave unset/blank. It is
# an envelope-only recipient for API/MCP/task sends, never a visible To/Bcc
# header. An external archive mailbox carries its own privacy and retention
# obligations and is a trusted archive boundary: it receives exact MIME,
# including internal-message stamps when present.
# ALWAYS_BCC must be an independent archive outside DOMAIN. Same-domain values
# are rejected: the shared catch-all makes them unsuitable as an independent
# compliance destination, and duplicate suppression is not that boundary.
# Every enabled archive requires an explicit 32+ character TASK_SIGNING_SECRET.
# The app enforces presence and length only, not entropy: generate a
# high-entropy value (this example uses `openssl rand -hex 32`). Bare-process
# SMTP_PASS fallback is allowed only with no archive. Compose already requires
# this secret.
# If at least one original RCPT is accepted and this configured archive RCPT is rejected, Nodemailer
# partial-success is preserved with a content-free warning, even if another
# original RCPT was rejected.
# If the archive is accepted while no original RCPT is reported accepted, the
# API fails even when SMTP omitted explicit rejected outcomes.
# Delivery failures after the provider accepts/queues it appear only in relay logs or DSNs, not
# synchronously in the API response.
# ALWAYS_BCC=archive@example.net

# Comma-separated domains that identities may use in From. Leave unset to allow
# sending from all configured domains (DOMAIN + EXTRA_DOMAINS); set to restrict.
# ALLOWED_SEND_DOMAINS=example.com

# Built-in read-only human inbox at /ui (true by default).
UI_ENABLED=true

# Task claim/lease endpoints and expiry recovery are opt-in. Default false = disabled.
# Single API process per mailbox required when enabled.
TASK_LEASES_ENABLED=false
# M3 reclaim decoupling (default false): claim derives expiry from server time; audit SMTP cannot block reclaim.
# Late-receipt tolerance is always on and is not gated by this flag.
TASK_LEASES_EXPIRY_AUDIT_M3=false
TASK_LEASES_OVERLAY_BOUND=false
# Public-read lease overlay bound (default false): list/detail stop replaying unindexed lease events after 15 minutes.
# M2 pending journal (default false): restart-safe generation fence + claim_lost; records/defers expiry-audit work. Requires TASK_LEASES_ENABLED.
# Production emitter stays hard-disabled. Genuine first provision only: docs/task-lease-journal.md
TASK_LEASES_PENDING_JOURNAL=false

# Optional public origin advertised in MCP RFC 9728 Protected Resource Metadata
# (and used instead of trusting the request Host). Use https for any non-loopback
# deployment so Bearer tokens are never implied over plaintext HTTP.
# MCP_PUBLIC_URL=https://mail.example.com

# MCP tools/call per-token rate limits (sliding window per minute; 0 = off).
# OAuth keys by grantId, oa_ by address; admin is exempt. Defaults: 60 / 20.
# MCP_RATE_READ_PER_MIN=60
# MCP_RATE_WRITE_PER_MIN=20

# 阻塞等待上限（秒）。mail_wait_for / task wait 静默钳到此值（默认 60，上限 600）。
# MCP_MAX_WAIT_SECONDS=60

# 信任 X-Forwarded-For 首跳（默认 false）。true 的硬性前置：反代必须覆写/剥离
# 客户端自供 XFF（见 docs/security.md）；append 式不满足。
# TRUST_PROXY_HEADERS=false

# 公网边缘：关闭 CIMD 私网 SSRF 例外（默认 false）。
# OAE_PUBLIC_EDGE=false

# ── OUTBOUND WEBHOOKS ───────────────────────────────────────────────────────
# Fail-closed；默认 false，与 parseConfig / Compose 插值一致。true 时仍要求上方
# TASK_SIGNING_SECRET 已设置且 ≥32（Compose 已强制该密钥）。
WEBHOOKS_ENABLED=false

# 可选签名根。整行保持注释/省略，让变量在容器中缺席（undefined）。
# 不要写成空值：空串或不足 32 字符会拒绝启动。需要独立根时用 openssl rand -hex 32。
# 同名已导出的 shell 变量优先于 env-file；轮换密钥时请先 unset，避免旧导出覆盖本文件。
# WEBHOOK_SIGNING_SECRET=
# WEBHOOK_SIGNING_SECRET_PREVIOUS=

# 是否允许私网 webhook 目标（默认 false）。OAE_PUBLIC_EDGE=true 时运行时强制 false。
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# 允许的目标端口 CSV（默认 443）。
# WEBHOOK_ALLOWED_PORTS=443

# 配额与投递上限。下列项允许显式 0：MAX_SUBSCRIPTIONS、MAX_PER_ADDRESS、
# APPROVAL_ARGS_MAX_BYTES、ROTATION_OVERLAP_MS、RATE_CREATE/TEST/DELIVER_PER_MIN。
# 其余项有各自下限。默认与 parseConfig 一致。
# 上限提示：MAX_ATTEMPTS<=11；PAYLOAD_MAX_BYTES bounded by JSON_BODY_LIMIT_BYTES。
# WEBHOOK_MAX_SUBSCRIPTIONS=16
# WEBHOOK_MAX_PER_ADDRESS=4
# WEBHOOK_MAX_ATTEMPTS=11
# WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# WEBHOOK_MAX_CONCURRENT=8
# WEBHOOK_POOL_RETRY_MS=5000
# WEBHOOK_PAYLOAD_MAX_BYTES=16384
# WEBHOOK_APPROVAL_ARGS_MAX_BYTES=4096
# WEBHOOK_APPROVAL_ARGS_MAX_DEPTH=4
# WEBHOOK_RESPONSE_MAX_BYTES=4096
# WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300
# WEBHOOK_DISABLE_THRESHOLD=10
# WEBHOOK_ROTATION_OVERLAP_MS=86400000
# WEBHOOK_LOG_RETENTION_DAYS=30
# WEBHOOK_RATE_CREATE_PER_MIN=10
# WEBHOOK_RATE_TEST_PER_MIN=3
# WEBHOOK_RATE_DELIVER_PER_MIN=60

# 预鉴权 IP 限量（每分钟；0 = 关）。MCP_PREAUTH 默认 120（引导握手探 401 余量）。
# OAUTH_RATE_PER_MIN=30
# MCP_PREAUTH_RATE_PER_MIN=120

# Per-identity send rate limit, messages per rolling hour (0 = unlimited).
SEND_RATE_LIMIT=20

# Auto-delete messages older than this many days (0 = keep forever).
RETENTION_DAYS=30

# The API binds localhost only by default. Use an SSH tunnel or TLS reverse
# proxy; never expose it directly to the public internet without protection.
# For multiple API-only instances, keep populated copies outside the repository
# (for example ../oae-api-only-env/alpha.env and beta.env) with mode 0600. Give
# each copy a different API_PORT, independently generated API_KEYS and TASK_SIGNING_SECRET,
# and mailbox/provider-appropriate IMAP/SMTP credentials. Launch each with a
# unique `docker compose -p` value (or a unique COMPOSE_PROJECT_NAME). Compose
# then gives every project its own api-data named volume. The container port
# stays fixed at 3100.
# API_BIND=127.0.0.1
# API_PORT=3100
